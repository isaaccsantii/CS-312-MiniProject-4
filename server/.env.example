# Copy this file to .env (in the server folder) and fill in your PostgreSQL password.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_postgres_password
PGDATABASE=BlogDB4
SESSION_SECRET=change-me-to-a-long-random-string
PORT=8000
# Where the React dev server runs (comma-separate several origins if needed)
CLIENT_ORIGIN=http://localhost:5173
